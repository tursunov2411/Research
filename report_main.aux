\@writefile{toc}{\contentsline {subsection}{\numberline {4.10}Value-Chain Positioning Map}{29}{subsection.4.10}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Uzbekistan's Directed Trade Network and Value-Chain Positioning. Nodes: UZB (orange, hub), CHN/JPN/KOR (teal, NE~Asian sources), KAZ/RUS/TUR (green, re-export markets), ROW (purple, commodity destination). Edge colours: orange = intermediate imports, blue = commodity exports, green = consumer/textile exports, grey = re-export potential. Edge width $\propto \log (\text  {trade volume})$; opacity $\propto $ intermediate goods share. Note: network is constructed from bilateral merchandise trade flows as a proxy; Uzbekistan is not covered by the OECD TiVA database. Source: Author calculations from OEC/BACI HS-section bilateral trade data.}}{30}{figure.caption.9}\protected@file@percent }
\newlabel{fig:trade_network_map}{{7}{30}{Uzbekistan's Directed Trade Network and Value-Chain Positioning. Nodes: UZB (orange, hub), CHN/JPN/KOR (teal, NE~Asian sources), KAZ/RUS/TUR (green, re-export markets), ROW (purple, commodity destination). Edge colours: orange = intermediate imports, blue = commodity exports, green = consumer/textile exports, grey = re-export potential. Edge width $\propto \log (\text {trade volume})$; opacity $\propto $ intermediate goods share. Note: network is constructed from bilateral merchandise trade flows as a proxy; Uzbekistan is not covered by the OECD TiVA database. Source: Author calculations from OEC/BACI HS-section bilateral trade data}{figure.caption.9}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.11}Intermediate Goods Dependence by Partner}{31}{subsection.4.11}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Intermediate Goods Dependence: Uzbekistan's Imports from Northeast Asia, 2010--2023. Panel~A: intermediate goods share (\%) --- note that partner-level shares appear near-constant because the HS-section proxy captures broad categories that remain structurally stable; the meaningful variation is in absolute volumes (Panel~B). Panel~B: absolute intermediate import volume (USD~bn), showing China's post-2017 surge. BEC Rev.5 proxy: HS sections 05, 06, 07, 15, 16, 17, 18. Orange dashed line marks the 2017 reform. Source: Author calculations from OEC/BACI bilateral trade data.}}{31}{figure.caption.10}\protected@file@percent }
\newlabel{fig:intermediate_dependence}{{8}{31}{Intermediate Goods Dependence: Uzbekistan's Imports from Northeast Asia, 2010--2023. Panel~A: intermediate goods share (\%) --- note that partner-level shares appear near-constant because the HS-section proxy captures broad categories that remain structurally stable; the meaningful variation is in absolute volumes (Panel~B). Panel~B: absolute intermediate import volume (USD~bn), showing China's post-2017 surge. BEC Rev.5 proxy: HS sections 05, 06, 07, 15, 16, 17, 18. Orange dashed line marks the 2017 reform. Source: Author calculations from OEC/BACI bilateral trade data}{figure.caption.10}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.12}Export Composition: Structural Change 2010--2023}{32}{subsection.4.12}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Uzbekistan Export Composition by Category, 2010--2023. Panel~A: category shares (\%); Panel~B: absolute volumes (USD~bn). Six categories shown: Gold/Precious Metals (HS~14, dominant at 50--60\%), Textiles, Other Primary, Intermediate Input, Capital/Machines, and Consumer/Other. Manufactured and machinery exports (HS~15--18 combined) remain below 10\% in aggregate. White dashed line marks the 2017 reform. Source: Author calculations from OEC/BACI HS-section export data.}}{32}{figure.caption.11}\protected@file@percent }
\newlabel{fig:export_composition}{{9}{32}{Uzbekistan Export Composition by Category, 2010--2023. Panel~A: category shares (\%); Panel~B: absolute volumes (USD~bn). Six categories shown: Gold/Precious Metals (HS~14, dominant at 50--60\%), Textiles, Other Primary, Intermediate Input, Capital/Machines, and Consumer/Other. Manufactured and machinery exports (HS~15--18 combined) remain below 10\% in aggregate. White dashed line marks the 2017 reform. Source: Author calculations from OEC/BACI HS-section export data}{figure.caption.11}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.13}Re-export Potential Through Central Asian Corridors}{33}{subsection.4.13}\protected@file@percent }
